NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/baxnaano_db?schema=public"

# JWT Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars"

# Frontend API Endpoint
VITE_API_URL="http://localhost:4000/api"
