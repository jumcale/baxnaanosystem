# ============================================================================
# BAXNAANO PHARMACY & VETERINARY CLINIC MANAGEMENT SYSTEM
# Environment Configuration Template (Placeholders Only — Do Not Commit .env)
# ============================================================================

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection (Use ?sslmode=require in production)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/baxnaano_db?schema=public"
POSTGRES_USER=baxnaano
POSTGRES_PASSWORD="<SET_STRONG_RANDOM_DB_PASSWORD>"
POSTGRES_DB=baxnaano_db

# JWT Secrets (Minimum 32 random characters; must be distinct in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="<GENERATE_RANDOM_64_HEX_CHAR_ACCESS_SECRET>"
JWT_REFRESH_SECRET="<GENERATE_RANDOM_64_HEX_CHAR_REFRESH_SECRET>"

# Frontend API Endpoint
VITE_API_URL="http://localhost:4000/api"
